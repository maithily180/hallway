{
  "name": "hallway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:floor": "node scripts/check-floor.mjs",
    "eval:inspector": "vitest run --config vitest.eval.config.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "spike": "tsx --env-file=.env scripts/spike.ts",
    "seed": "tsx scripts/seed-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bryntum/scheduler-trial": "7.3.8",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zod": "4.1.12",
    "@prisma/client": "^6.19.3",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
