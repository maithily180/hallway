DATABASE_URL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_EMAIL=          # Plan B receiver
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
ANTHROPIC_API_KEY=
EMBEDDINGS_API_KEY=
CHANNEL3_API_KEY=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
CAMPUS_EMAIL_DOMAIN=            # e.g. demo.edu
MOCK_PAYPAL=0
MOCK_LLM=0
AUTH_SECRET=                    # signs session cookies
DEMO_PASSWORD=                  # shared password for demo and judge logins
HANDOVER_SECRET=                # signs the rental QR codes; any long random string
APP_URL=http://localhost:3000   # PayPal return URLs and webhook registration
PAYEE_MODE=platform             # platform (Plan B: Hallway receives, then pays out) | direct (Plan A: seller is the payee)
NEXT_PUBLIC_MOCK_PAYPAL=0       # 1 = the checkout button skips the PayPal SDK (use with MOCK_PAYPAL=1)
SANDBOX_MAYA_EMAIL=             # sandbox seller; used by scripts/spike.ts and the memory store
SANDBOX_LEO_EMAIL=              # sandbox buyer
CRON_SECRET=                    # protects POST /api/jobs/reauthorize (the hold-refresh job)
